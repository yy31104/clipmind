# ── AI 总结（可选）──────────────────────────────────────────
# 不填也能用：转写、OCR、关键帧全部照常，只是笔记不经过模型归纳。
# ANTHROPIC_API_KEY=sk-ant-...
# CLIPMIND_SUMMARY_MODEL=claude-sonnet-5

# ── 采集 ────────────────────────────────────────────────────
# 按顺序尝试的 cookie 来源，"-" 表示不带 cookie
# CLIPMIND_COOKIE_SOURCES=chrome,-
# 如果不想让程序读浏览器 cookie，改用导出的 cookies.txt：
# CLIPMIND_COOKIE_SOURCES=-
# CLIPMIND_COOKIE_FILE=/path/to/cookies.txt

# ── 并发（按机器性能调）──────────────────────────────────────
# CLIPMIND_MAX_VIDEOS=4     同时处理的视频数
# CLIPMIND_MAX_ASR=1        语音转写并发（GPU 只有一块，建议 1）
# CLIPMIND_MAX_OCR=2

# ── 视觉证据 ────────────────────────────────────────────────
# CLIPMIND_SAMPLE_FPS=2         候选帧采样率
# CLIPMIND_SAMPLE_WIDTH=640     变化检测输入宽度
# CLIPMIND_EVIDENCE_WIDTH=1280  最终证据与 OCR 输入宽度
# CLIPMIND_DEDUPE_THRESHOLD=6   越小越严格，保留的帧越多
# 仅旧 note.md 兼容预览使用；不限制 visual_states/all 或 preview：
# CLIPMIND_MAX_KEYFRAMES=10

# ── 其他 ────────────────────────────────────────────────────
# CLIPMIND_KEEP_VIDEO=1     处理完保留源视频（默认删除，省磁盘）
# CLIPMIND_ASR_MODEL=mlx-community/whisper-large-v3-turbo
# CLIPMIND_KB_INBOX=/absolute/path/to/your/knowledge-base/Inbox
