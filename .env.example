# Copy selected lines to .env. Defaults are shown below.

# ── Library ────────────────────────────────────────────────────────────────
# CLIPMIND_OUT=/absolute/path/to/clipmind-library
# CLIPMIND_KB_INBOX=/absolute/path/to/your-knowledge-base/Inbox
# CLIPMIND_MAX_UPLOAD_MB=10240
# CLIPMIND_KEEP_VIDEO=0

# ── URL acquisition ───────────────────────────────────────────────────────
# Ordered cookie sources; "-" means no cookies.
# CLIPMIND_COOKIE_SOURCES=chrome,-
# To avoid browser-cookie access, use only "-". A narrow exported cookie file
# can be added separately; protect it like a password.
# CLIPMIND_COOKIE_FILE=/absolute/path/to/cookies.txt
# CLIPMIND_FORMAT=bv*+ba/b

# ── Concurrency ────────────────────────────────────────────────────────────
# CLIPMIND_MAX_VIDEOS=4
# CLIPMIND_MAX_FETCH=4
# CLIPMIND_MAX_ASR=1
# CLIPMIND_MAX_OCR=2

# ── Visual evidence ───────────────────────────────────────────────────────
# CLIPMIND_SAMPLE_FPS=2
# CLIPMIND_SAMPLE_WIDTH=640
# CLIPMIND_EVIDENCE_WIDTH=1280
# CLIPMIND_DEDUPE_THRESHOLD=6
# CLIPMIND_OCR_LANGUAGES=zh-Hans,zh-Hant,en-US
# canonical visual_states/all and derived preview have no fixed count limit.

# ── Local providers ────────────────────────────────────────────────────────
# CLIPMIND_ASR_PROVIDER=auto              # auto | mlx | faster-whisper
# CLIPMIND_ASR_MODEL=mlx-community/whisper-large-v3-turbo
# CLIPMIND_FASTER_WHISPER_MODEL=large-v3-turbo
# CLIPMIND_ASR_LANGUAGE=zh                # empty enables provider auto-detection
# CLIPMIND_OCR_PROVIDER=auto              # auto | vision | tesseract (portable extra)
# CLIPMIND_TESSERACT_LANGUAGES=chi_sim+chi_tra+eng
# CLIPMIND_DIARIZATION_PROVIDER=none      # none | pyannote
# CLIPMIND_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
# HF_TOKEN=                               # only for optional pyannote model

# ── Complete-pack preflight ────────────────────────────────────────────────
# Limits refuse before expensive work. Explicit force runs the complete source;
# ClipMind never truncates or automatically lowers evidence resolution.
# CLIPMIND_MAX_CANONICAL_STATES=1000
# CLIPMIND_MAX_ESTIMATED_OCR_SECONDS=180
# CLIPMIND_MAX_ESTIMATED_PACK_MB=150
# CLIPMIND_ESTIMATED_OCR_SECONDS_PER_STATE=0.15
# CLIPMIND_ESTIMATED_PACK_MB_PER_STATE=0.08
