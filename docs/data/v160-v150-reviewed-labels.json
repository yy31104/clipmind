          "text": "func Retry(f func() error, n int, interval time.Duration) error {\n    var err error\n    for range n {\n        if err = f(); err != nil {\n            time.Sleep(interval)\n        } else {\n            return nil\n        }\n    }\n    return fmt.Errorf(\"failed to execute the function after %d tries. Last\nerror: %s\", n, err.Error())\n}",
